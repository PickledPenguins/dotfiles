" vim-plug plugins.  Enable by removing .off, then :PlugInstall.
" Install vim-plug first:
"   curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
"     https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

if empty(glob('~/.vim/autoload/plug.vim'))
  finish
endif

call plug#begin('~/.vim/plugged')
Plug 'tpope/vim-commentary'       " gcc to comment a line
Plug 'tpope/vim-surround'         " cs"' to change surrounding quotes
Plug 'tpope/vim-fugitive'         " :Git
Plug 'airblade/vim-gitgutter'     " changed lines in the sign column
Plug 'junegunn/fzf.vim'           " :Files :Rg :Buffers
call plug#end()
