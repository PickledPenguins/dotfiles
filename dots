#!/usr/bin/env python3
"""dots: a small chezmoi-alike that symlinks instead of copying.

The source directory mirrors $HOME. A source path becomes a target path by
stripping attribute prefixes from every component:

    dot_         leading "." on the target name
    private_     chmod go-rwx on the source (the link inherits it)
    executable_  chmod u+x on the source

    dot_config/git/config         ->  ~/.config/git/config
    private_dot_ssh/config        ->  ~/.ssh/config          (mode 600)
    dot_local/bin/executable_hi   ->  ~/.local/bin/hi        (mode u+x)

Directories are created for real; every file is a symlink back into the
source directory. Directories whose name starts with "." (.git) are never
managed, at any depth; neither are such files in the root (.dotsignore),
while deeper ones are (private_dot_ssh/sockets/.keep). .dotsignore lists
further target paths to skip. A home file whose name starts with an
attribute prefix (~/private_notes) cannot be managed: add refuses it.

`dots options` reads the settings back out of the configuration files that
mention it: a comment directly above a setting describes it, and a setting
whose comment character is followed directly by code ("#shopt -s x") is off.

Exit status: 0 on success; 1 when apply leaves conflicts, status finds
anything not ok, forget names an unmanaged path or one it refuses, or
options matches nothing; 2 for usage errors and a missing source directory.
"""

import argparse
import fnmatch
import os
import re
import shutil
import stat
import sys
import time
from pathlib import Path

IGNORE_FILE = ".dotsignore"

# ── source state ──────────────────────────────────────────────────────────


def source_dir():
    """Resolve the source directory: $DOTS_SOURCE if set, else the tree holding this script, else ~/.dotfiles"""
    if os.environ.get("DOTS_SOURCE"):
        return Path(os.environ["DOTS_SOURCE"]).resolve()
    # a checkout's dots manages that checkout, not whatever ~/.dotfiles is
    own = Path(__file__).resolve().parent
    if (own / IGNORE_FILE).is_file():
        return own
    default = Path.home() / ".dotfiles"
    return default.resolve() if default.is_dir() else own


def parse_name(name):
    """Split one source component into (target name, private, executable)."""
    private = executable = False
    while True:
        if name.startswith("private_"):
            private, name = True, name[len("private_"):]
        elif name.startswith("executable_"):
            executable, name = True, name[len("executable_"):]
        elif name.startswith("dot_"):
            return "." + name[len("dot_"):], private, executable
        else:
            return name, private, executable


def load_ignores(src):
    path = src / IGNORE_FILE
    if not path.is_file():
        return []
    lines = (l.strip() for l in path.read_text().splitlines())
    return [l for l in lines if l and not l.startswith("#")]


def ignored(rel, patterns):
    """True when the target-relative path or any of its parents matches a pattern."""
    parts = Path(rel).parts
    for i in range(1, len(parts) + 1):
        prefix = "/".join(parts[:i])
        if any(fnmatch.fnmatch(prefix, p) for p in patterns):
            return True
    return False


class Entry:
    """One managed file: where it lives in the source and where its link goes."""

    def __init__(self, src, home, source_rel):
        self.source = src / source_rel
        parts, self.private, self.executable = [], False, False
        self.private_dirs = []          # target directories that get mode 700
        components = Path(source_rel).parts
        for component in components:
            name, private, executable = parse_name(component)
            parts.append(name)
            self.private |= private
            self.executable |= executable
            # a private_ directory and everything below it is 700
            if self.private and len(parts) < len(components):
                self.private_dirs.append(home.joinpath(*parts))
        self.rel = "/".join(parts)
        self.target = home / self.rel


def managed_entries(src, home):
    """Every file under src that should be linked into home, sorted by target."""
    patterns = load_ignores(src)
    entries = []
    for root, dirs, files in os.walk(src):
        rel_root = Path(root).relative_to(src)
        dirs[:] = sorted(d for d in dirs if not d.startswith("."))
        for name in sorted(files):
            if name.startswith(".") and rel_root == Path("."):
                continue
            entry = Entry(src, home, rel_root / name)
            if any(part in ("", ".", "..") for part in entry.rel.split("/")):
                # "dot_" alone would map to ~/. -- the home directory itself
                print(f"dots: ignoring {rel_root / name}: maps to '{entry.rel}'", file=sys.stderr)
                continue
            if not ignored(entry.rel, patterns):
                entries.append(entry)
    return sorted(entries, key=lambda e: e.rel)


# ── target state ──────────────────────────────────────────────────────────


def state(entry, src):
    """What the target currently is.

    ok          symlink to the source file
    missing     nothing there
    stale-link  symlink somewhere else inside the source tree (file was renamed)
    conflict    a real file, or a symlink to somewhere outside the source tree
    """
    target = entry.target
    if not target.exists() and not target.is_symlink():
        return "missing"
    if target.is_symlink():
        link = os.readlink(target)
        if link == str(entry.source):
            return "ok"
        if link.startswith(str(src) + os.sep):
            return "stale-link"
    return "conflict"


def linked_dir(entry, src, home):
    """The directory above the target, below home, that is a symlink into the
    source tree, or None. Through such a link the target IS the source file."""
    for rel in reversed(list(Path(entry.rel).parents)[:-1]):
        directory = home / rel
        if directory.is_symlink() and os.path.realpath(directory).startswith(str(src) + os.sep):
            return rel
    return None


def set_mode(entry):
    """Apply private_/executable_ to the source file; the link shows the same bits."""
    mode = entry.source.stat().st_mode
    if entry.private:
        mode &= ~(stat.S_IRWXG | stat.S_IRWXO)
    if entry.executable:
        mode |= stat.S_IXUSR
    os.chmod(entry.source, stat.S_IMODE(mode))
    for directory in entry.private_dirs:
        os.chmod(directory, 0o700)


def backup(path, rel, backup_root):
    """Move path into the backup tree as the home-relative rel"""
    dest = backup_root / rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(path), str(dest))
    return dest


# ── commands ──────────────────────────────────────────────────────────────


def cmd_apply(args, src, home):
    entries = [e for e in managed_entries(src, home) if selected(e, args.paths, home)]
    backup_root = home / ".dotfiles-backup" / time.strftime("%Y%m%d-%H%M%S")
    changed = conflicts = 0
    for entry in entries:
        current = state(entry, src)
        if current == "ok":
            if not args.dry_run:
                set_mode(entry)
            continue
        if current == "conflict":
            through = linked_dir(entry, src, home)
            if through or not args.force:
                hint = (f"{through} links into the source; make it a real directory" if through
                        else "use --force to back it up and replace")
                print(f"conflict  {entry.rel}  ({hint})")
                conflicts += 1
                continue
        verb = {"missing": "link", "stale-link": "relink", "conflict": "replace"}[current]
        print(f"{verb:<9} {entry.rel}  ->  {entry.source}")
        changed += 1
        if args.dry_run:
            continue
        if current == "conflict":
            print(f"backup    {entry.rel}  ->  {backup(entry.target, entry.rel, backup_root)}")
        elif current == "stale-link":
            entry.target.unlink()
        entry.target.parent.mkdir(parents=True, exist_ok=True)
        os.symlink(entry.source, entry.target)
        set_mode(entry)
    print(f"{changed} change(s){' (dry run)' if args.dry_run else ''}"
          + (f", {conflicts} conflict(s) left" if conflicts else ""))
    return 1 if conflicts else 0


def cmd_status(args, src, home):
    entries = [e for e in managed_entries(src, home) if selected(e, args.paths, home)]
    counts = {}
    for entry in entries:
        current = state(entry, src)
        counts[current] = counts.get(current, 0) + 1
        if current != "ok" or args.all:
            print(f"{current:<11} {entry.rel}")
    print("  ".join(f"{k}: {v}" for k, v in sorted(counts.items())) or "nothing managed")
    return 0 if set(counts) <= {"ok"} else 1


def cmd_managed(args, src, home):
    for entry in managed_entries(src, home):
        print(entry.source if args.show_source else entry.rel)
    return 0


def cmd_unlink(args, src, home):
    entries = [e for e in managed_entries(src, home) if selected(e, args.paths, home)]
    removed = 0
    for entry in entries:
        if state(entry, src) == "ok":
            print(f"unlink    {entry.rel}")
            removed += 1
            if not args.dry_run:
                entry.target.unlink()
    print(f"{removed} link(s) removed{' (dry run)' if args.dry_run else ''}")
    return 0


def cmd_prune(args, src, home):
    """Remove symlinks into the source tree whose file no longer exists.

    A moved or deleted source path leaves its old link behind, and that link
    is no longer a target, so apply and unlink never see it. Only links that
    point inside the source tree AND are broken are removed; a link into the
    tree that still resolves is someone's deliberate choice and stays.
    """
    entries = managed_entries(src, home)
    roots = {home / e.rel.split("/")[0] for e in entries}
    candidates = [p for p in home.iterdir() if p.is_symlink()]
    for root in sorted(roots):
        if root.is_dir() and not root.is_symlink():
            for dirpath, _, files in os.walk(root):
                candidates += [Path(dirpath) / f for f in files if (Path(dirpath) / f).is_symlink()]
    removed = 0
    for path in sorted(set(candidates)):
        link = os.readlink(path)
        if not link.startswith(str(src) + os.sep) or os.path.exists(link):
            continue
        print(f"prune     {path.relative_to(home)}  ->  {link}")
        removed += 1
        if not args.dry_run:
            path.unlink()
    print(f"{removed} dangling link(s) removed{' (dry run)' if args.dry_run else ''}")
    return 0


def cmd_options(args, src, home):
    """List the options in every managed file that is written in the options format."""
    words = [w.lower() for w in args.words]
    found = 0
    for entry in managed_entries(src, home):
        try:
            text = entry.source.read_text()
        except (OSError, UnicodeDecodeError):       # unreadable or binary: not a config file
            continue
        if OPTIONS_TAG not in text:
            continue
        shown = []
        for option in parse_options(text, comment_marker(entry.rel)):
            if not option.summary or args.state not in (None, option.state):
                continue
            haystack = "\n".join([entry.rel, *option.doc, *option.code]).lower()
            if all(word in haystack for word in words):
                shown.append(option)
        if shown:
            print(f"~/{entry.rel}")
        for option in shown:
            text = [d for d in option.doc if d]
            first, rest = (text[0], text[1:] + option.code) if args.full else (option.summary, [])
            print(f"{option.line:>6}  {option.state:<3}  {first}")
            for line in rest:
                print(f"{'':13}{line}".rstrip())
        found += len(shown)
    return 0 if found else 1


# ── the options format ────────────────────────────────────────────────────

OPTIONS_TAG = "dots options"        # a file that mentions this is read by `dots options`


def comment_marker(rel):
    """The comment character of a target's format: vim script, X resources, else #.

    A module switched off by an .off suffix keeps its format.
    """
    name = rel.rsplit("/", 1)[-1]
    name = name[:-len(".off")] if name.endswith(".off") else name
    if name == ".vimrc" or name.endswith(".vim"):
        return '"'
    return "!" if name == ".Xresources" else "#"


class Option:
    """One setting in a configuration file: its description, its code, on or off."""

    def __init__(self, line, doc, state):
        self.line, self.doc, self.state, self.code = line, doc, state, []

    @property
    def summary(self):
        """The description's first sentence, Needs: lines left out, at most 100 characters."""
        text = " ".join(d for d in self.doc if d and not d.startswith("Needs:"))
        match = re.match(r"(.*?[\w)\]'\"`][.!?])(\s|$)", text)
        sentence = match.group(1) if match else text
        return sentence if len(sentence) <= 100 else sentence[:97].rsplit(" ", 1)[0] + "..."


def parse_options(text, marker):
    """Split a configuration file into options.

    A comment line whose marker is followed by a space, or by nothing, is
    description. One whose marker is followed directly by code is a setting
    switched off: "#shopt -s histverify". Description attaches to the code
    right below it and a blank line ends an option. Code with nothing above
    it -- a [section] header, the line after a switched-off one -- comes back
    with an empty description.
    """
    options, doc, current = [], [], None
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or (number == 1 and line.startswith("#!")):
            doc, current = [], None
            continue
        rest = line[len(marker):]
        if line.startswith(marker) and (not rest or rest[0].isspace() or rest[0] == marker):
            doc.append(rest.strip())
            current = None
            continue
        state = "off" if line.startswith(marker) else "on"
        if doc or current is None or current.state != state:
            current = Option(number, doc, state)
            options.append(current)
            doc = []
        current.code.append(raw)
    return options


def source_name(rel_path, private, executable):
    """Build the source-relative path for a target path, adding attribute prefixes."""
    parts = []
    for i, component in enumerate(Path(rel_path).parts):
        last = i == len(Path(rel_path).parts) - 1
        name = "dot_" + component[1:] if component.startswith(".") else component
        if last and executable:
            name = "executable_" + name
        if last and private:
            name = "private_" + name
        parts.append(name)
    return Path(*parts)


def reuse_source_dirs(src, source_rel):
    """source_rel with each directory swapped for an existing source directory
    that maps to the same target name: a file added under ~/.ssh goes into
    private_dot_ssh/ when that exists, not into a new dot_ssh/ beside it."""
    directory = src
    for component in source_rel.parts[:-1]:
        name = parse_name(component)[0]
        existing = [d for d in sorted(directory.glob("*"))
                    if d.is_dir() and not d.name.startswith(".") and parse_name(d.name)[0] == name]
        directory = existing[0] if existing else directory / component
    return directory / source_rel.name


def cmd_add(args, src, home):
    """Move real files into the source tree and leave symlinks behind."""
    for raw in args.paths:
        target = Path(os.path.abspath(os.path.expanduser(raw)))
        try:
            rel = target.relative_to(home)
        except ValueError:
            print(f"skip      {target}: not under {home}")
            continue
        if target.is_symlink():
            print(f"skip      {rel}: already a symlink")
            continue
        if not target.is_file():
            print(f"skip      {rel}: not a regular file (add files, not directories)")
            continue
        mode = target.stat().st_mode
        source_rel = source_name(rel, args.private or not mode & stat.S_IRWXO, bool(mode & stat.S_IXUSR))
        if "/".join(parse_name(c)[0] for c in source_rel.parts) != str(rel):
            # ~/private_notes would be stored as private_notes, the source of ~/notes
            print(f"skip      {rel}: a name starts with dot_, private_ or executable_")
            continue
        if ignored(str(rel), load_ignores(src)):
            # stored there, the file would sit in the repository's own files, never linked
            print(f"skip      {rel}: ignored by {IGNORE_FILE}")
            continue
        dest = reuse_source_dirs(src, source_rel)
        if dest.exists():
            print(f"skip      {rel}: {dest} already exists")
            continue
        print(f"add       {rel}  ->  {dest.relative_to(src)}")
        if args.dry_run:
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(target), str(dest))
        os.symlink(dest, target)
    return 0


def cmd_forget(args, src, home):
    """Stop managing targets, keeping each file: the source becomes a real copy at
    the target, or goes to the backup tree when something else is there."""
    wanted = {str(Path(os.path.abspath(os.path.expanduser(p)))) for p in args.paths}
    backup_root = home / ".dotfiles-backup" / time.strftime("%Y%m%d-%H%M%S")
    refused = 0
    for entry in managed_entries(src, home):
        if str(entry.target) not in wanted:
            continue
        wanted.discard(str(entry.target))
        through = linked_dir(entry, src, home)
        if through:
            # the target is the source file: removing the source removes both
            print(f"skip      {entry.rel}: {through} links into the source; make it a real directory")
            refused += 1
            continue
        print(f"forget    {entry.rel}")
        if args.dry_run:
            continue
        found = state(entry, src)
        if found == "conflict":
            # the file at the target is not ours: leave it, keep the source aside
            print(f"backup    {entry.rel}  ->  {backup(entry.source, entry.rel, backup_root)}")
            continue
        if found != "missing":
            entry.target.unlink()
        entry.target.parent.mkdir(parents=True, exist_ok=True)
        set_mode(entry)
        shutil.copy2(entry.source, entry.target)
        entry.source.unlink()
    for path in sorted(wanted):
        print(f"skip      {path}: not managed")
    return 1 if wanted or refused else 0


def selected(entry, paths, home):
    """Restrict a command to targets under any of the given paths (all when none given)."""
    if not paths:
        return True
    for raw in paths:
        p = Path(os.path.abspath(os.path.expanduser(raw)))
        if entry.target == p or p in entry.target.parents:
            return True
    return False


def main(argv=None):
    parser = argparse.ArgumentParser(prog="dots", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("-S", "--source", help="source directory (default: $DOTS_SOURCE, this checkout, ~/.dotfiles)")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("apply", help="create or repair the symlinks")
    p.add_argument("paths", nargs="*", help="only targets under these paths")
    p.add_argument("-n", "--dry-run", action="store_true", help="print the plan, change nothing")
    p.add_argument("--force", action="store_true", help="back up and replace real files")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("status", help="show targets that are not linked correctly")
    p.add_argument("paths", nargs="*", help="only targets under these paths")
    p.add_argument("-a", "--all", action="store_true", help="list every target")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("managed", help="list managed target paths")
    p.add_argument("-s", "--show-source", action="store_true", help="print source paths instead")
    p.set_defaults(func=cmd_managed)

    p = sub.add_parser("add", help="move files into the source tree and link them back")
    p.add_argument("paths", nargs="+", help="regular files under $HOME")
    p.add_argument("-n", "--dry-run", action="store_true", help="print the moves, change nothing")
    p.add_argument("--private", action="store_true", help="force the private_ attribute")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("forget", help="stop managing targets, leaving real copies in place")
    p.add_argument("paths", nargs="+", help="managed target paths")
    p.add_argument("-n", "--dry-run", action="store_true", help="print what would be forgotten")
    p.set_defaults(func=cmd_forget)

    p = sub.add_parser("unlink", help="remove the symlinks (source untouched)")
    p.add_argument("paths", nargs="*", help="only targets under these paths")
    p.add_argument("-n", "--dry-run", action="store_true", help="print the removals, change nothing")
    p.set_defaults(func=cmd_unlink)

    p = sub.add_parser("prune", help="remove dangling symlinks into the source tree")
    p.add_argument("-n", "--dry-run", action="store_true", help="print the removals, change nothing")
    p.set_defaults(func=cmd_prune)

    p = sub.add_parser("options", help="list the settings in the configuration files, on and off")
    p.add_argument("words", nargs="*", help="only options whose file, description or code has every word")
    state = p.add_mutually_exclusive_group()
    state.add_argument("--on", dest="state", action="store_const", const="on", help="only settings that are on")
    state.add_argument("--off", dest="state", action="store_const", const="off", help="only settings that are off")
    p.add_argument("-f", "--full", action="store_true", help="also print each description in full and its code")
    p.set_defaults(func=cmd_options)

    args = parser.parse_args(argv)
    src = Path(args.source).resolve() if args.source else source_dir()
    if not src.is_dir():
        print(f"dots: source directory {src} does not exist", file=sys.stderr)
        return 2
    return args.func(args, src, Path.home())


if __name__ == "__main__":
    sys.exit(main())
