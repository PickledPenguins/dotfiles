# ~/.ctags.d/default.ctags -- universal-ctags defaults, for `ctags` in a
# project.  Comments must be on their own lines here.
#
# Each setting has its description in the comment above it.  A setting with
# "#" directly in front of it is off: delete that "#" to turn it on, or add
# one to turn a setting off.  `dots options WORD` searches every file.

# `ctags` alone indexes the whole tree below the current directory, with
# paths relative to the tags file.
--recurse=yes
--tag-relative=yes

# Qualified tags (Class.method) as well as plain ones.
--extras=+q

# Inheritance, access, language and signature in each tag, for editors
# that show them.
--fields=+ialS

# Never index version control, virtualenvs, dependencies, caches, build
# output, or minified and map files.
--exclude=.git
--exclude=.venv
--exclude=node_modules
--exclude=__pycache__
--exclude=build
--exclude=dist
--exclude=*.min.js
--exclude=*.map

# JSON and SQL files are not indexed (big, and rarely worth jumping into).
--languages=-json,-sql

# Markdown headings are not indexed either.
#--languages=-markdown
