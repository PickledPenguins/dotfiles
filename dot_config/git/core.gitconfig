[core]
    editor = vim
    pager = less -FRX
    whitespace = trailing-space,space-before-tab
    # global ignore is ~/.config/git/ignore -- git reads it without being told

[init]
    defaultBranch = main

[push]
    default = current            # `git push` pushes the current branch to its namesake
    autoSetupRemote = true       # ... creating the upstream on first push

[pull]
    rebase = true                # no merge bubbles from `git pull`

[fetch]
    prune = true                 # drop remote-tracking branches deleted upstream

[rebase]
    autoStash = true
    autoSquash = true

[merge]
    conflictStyle = zdiff3       # show the base in conflict markers

[diff]
    algorithm = histogram
    colorMoved = default
    renames = true

[rerere]
    enabled = true               # remember conflict resolutions
    autoupdate = true

[status]
    showStash = true

[log]
    date = iso

[branch]
    sort = -committerdate

[help]
    autocorrect = prompt
