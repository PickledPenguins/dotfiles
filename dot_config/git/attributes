# attributes: the global gitattributes (~/.config/git/attributes).
#
# Each setting has its description in the comment above it. A setting with
# "#" directly in front of it is off: delete that "#" to turn it on, or add
# one to turn a setting off. `dots options WORD` searches every file.
# A project's own .gitattributes wins over these.

# Hunk headers name the enclosing function or section (git's built-in
# language drivers), and word diffs split words the language's way.
*.c        diff=cpp
*.h        diff=cpp
*.cpp      diff=cpp
*.py       diff=python
*.sh       diff=bash
*.bash     diff=bash
*.rs       diff=rust
*.go       diff=golang
*.java     diff=java
*.md       diff=markdown
*.tex      diff=tex
*.html     diff=html
*.css      diff=css

# Binary: no text diff, no merge, no line-ending conversion.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.tar      binary
*.h5       binary
*.npy      binary
*.pkl      binary

# Always LF, whatever core.autocrlf says: scripts break with CRLF. In a
# repository that committed them with CRLF they show as modified from the
# clone on.
*.sh       text eol=lf
Makefile   text eol=lf

# PDFs diffed as their text (turn on [diff "pdf"] in diff.gitconfig too).
#*.pdf      diff=pdf

# Word documents diffed as their text (turn on [diff "docx"] in diff.gitconfig too).
#*.docx     diff=docx

# Minified files and lock files: no diff text, marked as generated.
#*.min.js   -diff linguist-generated
#*.lock     -diff linguist-generated
