# color.gitconfig: colors. auto means only when writing to a terminal.
#
# Each setting has its description in the comment above it. A setting with
# "#" directly in front of it is off: delete that "#" to turn it on, or add
# one to turn a setting off. `dots options WORD` searches every file.
# For one machine only, put the line in ~/.gitconfig.local instead.

[color]
    # Color in every command that supports it, on a terminal.
    ui = auto

[color "branch"]
    # git branch: current branch bold green, local white, remote cyan.
    current = green bold
    local = white
    remote = cyan
    upstream = cyan dim

[color "diff"]
    # git diff: headers yellow, hunk markers magenta, removed red, added
    # green, whitespace errors reversed red.
    meta = yellow
    frag = magenta bold
    func = magenta
    old = red
    new = green
    whitespace = red reverse

    # Moved lines (diff.colorMoved) in their own colors instead of the defaults.
    #oldMoved = blue
    #newMoved = cyan

[color "status"]
    # git status: staged green, modified yellow, untracked red.
    added = green
    changed = yellow
    untracked = red
    branch = green bold

[color "decorate"]
    # Ref names in git log: branches green, remotes cyan, tags yellow, HEAD red.
    branch = green bold
    remoteBranch = cyan
    tag = yellow bold
    HEAD = red bold

[color "blame"]
    # git blame colors lines by age, the newest brightest (with
    # blame.coloring below).
    #highlightRecent = 237, 20 month ago, 239, 12 month ago, 244, 1 month ago, 250

[blame]
    # git blame shades lines by the age of the commit that wrote them.
    #coloring = highlightRecent
