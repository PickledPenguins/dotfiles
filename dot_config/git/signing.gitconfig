# signing.gitconfig: sign commits and tags.  Off until its include line in
# ~/.gitconfig is on; needs user.signingkey in ~/.gitconfig.local:
#
#   GPG:  the key ID from  gpg --list-secret-keys --keyid-format long
#   ssh:  the public key file, user.signingkey = ~/.ssh/id_ed25519.pub
#
# Each setting has its description in the comment above it.  A setting with
# "#" directly in front of it is off: delete that "#" to turn it on, or add
# one to turn a setting off.  `dots options WORD` searches every file.
# For one machine only, put the line in ~/.gitconfig.local instead.

[commit]
    # Sign every commit.
    gpgSign = true

[tag]
    # Sign every annotated tag.
    gpgSign = true

[push]
    # Sign pushes when the server asks for it (few do).
    #gpgSign = if-asked

[gpg]
    # Sign with gpg.
    program = gpg

    # Sign with an ssh key instead of gpg (git 2.34+): no gpg needed.
    #format = ssh

[gpg "ssh"]
    # The keys `git log --show-signature` trusts for ssh signatures, one
    # "email key" line each.
    #allowedSignersFile = ~/.ssh/allowed_signers

[log]
    # git log checks and shows every commit's signature (slower).
    #showSignature = true
