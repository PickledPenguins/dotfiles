# signing.gitconfig -- sign commits and tags.  Off until included from
# ~/.gitconfig; needs user.signingkey in ~/.gitconfig.local.
#
# GPG (default below):   gpg --list-secret-keys --keyid-format long
# SSH key instead:       uncomment the [gpg] format line and set
#                        user.signingkey = ~/.ssh/id_ed25519.pub

[commit]
    gpgSign = true

[tag]
    gpgSign = true

[gpg]
    program = gpg
    # format = ssh

[gpg "ssh"]
    # allowedSignersFile = ~/.ssh/allowed_signers    # for `git log --show-signature`
