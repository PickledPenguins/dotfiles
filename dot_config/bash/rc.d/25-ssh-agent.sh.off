# 25-ssh-agent.sh -- one ssh-agent per machine, shared by every shell.
# Off by default: desktops usually run an agent already (gnome-keyring,
# KDE wallet, 1Password).  Enable on headless boxes and ssh-only hosts.
#
# The agent's environment is saved to ~/.ssh/agent.env; a new shell reads it
# and only starts a fresh agent when that one is gone.  Keys are added on
# first use by `AddKeysToAgent yes` in ~/.ssh/config, so nothing prompts
# for a passphrase at login.
#
# Knobs (set in ~/.bashrc.before):
#   DOTFILES_SSH_AGENT_ENV   where to keep the agent env   default: ~/.ssh/agent.env
#   DOTFILES_SSH_AGENT_KEYS  keys to add at start          default: none (added on use)

_agent_env="${DOTFILES_SSH_AGENT_ENV:-$HOME/.ssh/agent.env}"

_ssh_agent_alive() {
    [[ -n "${SSH_AUTH_SOCK-}" && -S "$SSH_AUTH_SOCK" ]] && ssh-add -l >/dev/null 2>&1
    [[ $? != 2 ]]            # 2 = cannot contact agent; 0/1 = alive (with/without keys)
}

if command -v ssh-agent >/dev/null && ! _ssh_agent_alive; then
    [[ -r "$_agent_env" ]] && source "$_agent_env" >/dev/null
    if ! _ssh_agent_alive; then
        mkdir -p "${_agent_env%/*}" && chmod 700 "${_agent_env%/*}"
        (umask 077; ssh-agent -s > "$_agent_env")
        source "$_agent_env" >/dev/null
        for _k in ${DOTFILES_SSH_AGENT_KEYS-}; do ssh-add "$_k" 2>/dev/null; done
        unset _k
    fi
fi
unset _agent_env
unset -f _ssh_agent_alive
