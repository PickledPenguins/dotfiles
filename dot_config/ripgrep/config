# ~/.config/ripgrep/config: ripgrep defaults, read because 00-env.sh sets
# RIPGREP_CONFIG_PATH. One flag per line, no quoting; a flag on the command
# line wins, and --no-config skips this file.
#
# Each setting has its description in the comment above it. A setting with
# "#" directly in front of it is off: delete that "#" to turn it on, or add
# one to turn a setting off. `dots options WORD` searches every file.

# Case-insensitive unless the pattern has a capital letter.
--smart-case

# Search hidden files and directories too, except .git, node_modules and
# __pycache__.
--hidden
--glob=!.git/
--glob=!node_modules/
--glob=!__pycache__/

# Lines longer than 250 columns show as a preview instead of in full
# (minified files). Every program that runs rg reads this file, vim's
# :grep and scripts included; rg --max-columns=0 shows full lines once.
--max-columns=250
--max-columns-preview

# Matches bold red, paths magenta, line numbers green.
--colors=match:fg:red
--colors=match:style:bold
--colors=path:fg:magenta
--colors=line:fg:green

# Follow symbolic links.
#--follow

# Results in path order: stable output, but no parallel searching (slower).
#--sort=path

# Search files that .gitignore lists (build output, vendored code), still
# skipping hidden ones unless --hidden.
#--no-ignore-vcs

# Leave minified JavaScript and lock files out.
#--glob=!*.min.js
#--glob=!*.lock
