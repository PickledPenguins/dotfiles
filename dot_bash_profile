# ~/.bash_profile -- login shells.  Sets nothing itself; ~/.bashrc has it all.
# Login-only work (ssh-agent, one-time PATH exports for non-interactive
# children) belongs in ~/.config/bash/profile.d/*.sh, if that directory exists.

for _p in "${XDG_CONFIG_HOME:-$HOME/.config}"/bash/profile.d/*.sh; do
    [[ -r "$_p" ]] && source "$_p"
done
unset _p

[[ -r ~/.bashrc ]] && source ~/.bashrc
