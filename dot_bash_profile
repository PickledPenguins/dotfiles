# ~/.bash_profile -- bash login shells (ssh, console, `bash -l`).
#
# Order:  ~/.profile  ->  ~/.config/bash/profile.d/*.sh  ->  ~/.bashrc
#
# Put login-only work in profile.d: things that should run once per session
# and be inherited by every child process (ssh-agent start, one-time exports,
# `umask`).  Interactive settings belong in rc.d, which ~/.bashrc loads.

[[ -r ~/.profile ]] && source ~/.profile

for _p in "${XDG_CONFIG_HOME:-$HOME/.config}"/bash/profile.d/*.sh; do
    [[ -r "$_p" ]] && source "$_p"
done
unset _p

[[ -r ~/.bashrc ]] && source ~/.bashrc
