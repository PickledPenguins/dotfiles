#!/usr/bin/env bash
# identity: refuse a commit whose author email is wrong for the remote's host.
# events: pre-commit
# config: hooks.email
#
# hooks.email takes one rule per value, HOST then an extended regular
# expression, matched unanchored as grep -E does:
#     git config --global --add hooks.email 'github.com @users\.noreply\.github\.com$'
#     git config --global --add hooks.email 'gitlab.example.com @example\.com$'
# For each remote URL (fetch and push, after url.*.insteadOf) whose host is
# a rule's HOST, the email the commit is authored with (user.email, or
# author.email or GIT_AUTHOR_EMAIL where set) must match its expression.
# A repository with no remote on such a host is not checked.
set -euo pipefail

mapfile -t rules < <(git config --get-all hooks.email || true)
((${#rules[@]})) || exit 0

# host URL: the host of a URL, lower case, or nothing for a local path
host() {
    local url=$1
    if [[ $url =~ ^[A-Za-z][A-Za-z0-9+.-]*://([^/]*@)?([^/:@]+) ]]; then
        echo "${BASH_REMATCH[2],,}"
    elif [[ $url =~ ^([^/:@]+@)?([^/:]+): ]]; then      # scp-like: [user@]host:path
        echo "${BASH_REMATCH[2],,}"
    fi
}

mapfile -t remotes < <(git remote)
hosts=$(for remote in "${remotes[@]}"; do
    { git remote get-url --all "$remote"; git remote get-url --push --all "$remote"; } | while IFS= read -r url; do
        host "$url"
    done
done | sort -u)
[[ -n $hosts ]] || exit 0
ident=$(git var GIT_AUTHOR_IDENT)
email=${ident##*<}
email=${email%%>*}
status=0
for rule in "${rules[@]}"; do
    [[ $rule == *' '* ]] || { echo "identity: hooks.email '$rule' is not HOST REGEX" >&2; exit 1; }
    rule_host=${rule%% *} regex=${rule#* }
    grep -qxF -e "${rule_host,,}" <<<"$hosts" || continue
    grep -qE -e "$regex" <<<"$email" && continue
    echo "identity: $email does not match $regex, which hooks.email asks for on $rule_host" >&2
    status=1
done
exit "$status"
