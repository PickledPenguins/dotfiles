#!/usr/bin/env bash
# secrets: refuse a commit that adds a private key, a token or a credentials file.
# events: pre-commit
#
# Looks at the lines the staged changes add for a private key block, AWS,
# GitHub, Slack, OpenAI and Anthropic tokens, and an assignment of a quoted
# string of 8 characters or more to a name such as password, secret, token
# or api_key; and at the names of added files: .env, .netrc, *.pem, *.key,
# *.p12, id_rsa, id_ed25519 and the like.  It is a list of patterns, not a
# scanner: it misses what does not match and flags examples that do.  A
# line holding the text hooks:allow-secret is not checked.
set -euo pipefail

tokens='-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,}|xox[abprs]-[A-Za-z0-9-]{10,}|sk-(ant-)?[A-Za-z0-9_-]{20,}'
assigned='(password|passwd|secret|token|api_?key)[a-z_]*["'\'']?[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{8,}["'\'']'
files='(^|/)(\.env(\..*)?|\.netrc|id_(rsa|dsa|ecdsa|ed25519)|[^/]*\.(pem|key|p12|pfx))$'

status=0
added=$(git diff --cached -U0 --no-color --no-ext-diff --no-renames --diff-filter=AM |
    awk '/^\+\+\+ /{file = substr($0, 7); next} /^\+/{print file ": " substr($0, 2)}' |
    grep -v 'hooks:allow-secret' || true)
found=$({ grep -E -e "$tokens" <<<"$added"; grep -Ei -e "$assigned" <<<"$added"; } | sort -u || true)
if [[ -n $found ]]; then
    printf 'secrets: %s\n' "${found//$'\n'/$'\n'secrets: }" >&2
    status=1
fi
while IFS= read -r path; do
    echo "secrets: $path is a file that usually holds a secret" >&2
    status=1
done < <(git diff --cached --name-only --no-renames --diff-filter=A | grep -E "$files" || true)
((status == 0)) || echo "secrets: remove them, or commit with --no-verify" >&2
exit "$status"
