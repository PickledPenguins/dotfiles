#!/usr/bin/env bash
# protect: refuse a push that deletes or rewrites a protected branch.
# events: pre-push
# config: hooks.protect
#
# hooks.protect is the list of protected branches, separated by spaces;
# the default is "main master".  A push deleting one, or one that is not a
# fast-forward of what the remote has (a force push), is refused.  A remote
# commit this repository has not fetched counts as a rewrite: fetch first.
set -euo pipefail

read -ra protected <<<"$(git config hooks.protect || echo main master)"
status=0
while read -r _ local_sha remote_ref remote_sha; do
    branch=${remote_ref#refs/heads/}
    [[ " ${protected[*]} " == *" $branch "* ]] || continue
    [[ $remote_sha == *[!0]* ]] || continue
    if [[ $local_sha != *[!0]* ]]; then
        echo "protect: deleting $branch on $1 refused (hooks.protect)" >&2
        status=1
    elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "protect: $branch on $1 would be rewritten, not fast-forwarded (hooks.protect)" >&2
        status=1
    fi
done
((status == 0)) || echo "protect: push with --no-verify to do it anyway" >&2
exit "$status"
