#!/usr/bin/env bash
# dispatch: run the hooks switched on for one git event.
#
# git hooks install writes .git/hooks/EVENT as a stub that sources this file
# (a copy, so writing it cannot change this one). Each .git/hooks/EVENT.d/NAME
# runs in name order, byte order (C) whatever LC_ALL or LC_COLLATE says (so
# no-commit-on runs before nocommit everywhere), with git's arguments, its
# stdin and GIT_HOOK_EVENT set to EVENT, under the caller's locale;
# NAME.off is switched off. For a post- event every hook runs and
# git ignores the status. For any other event the first hook to fail stops
# the rest and fails the event, so git stops the commit, merge or push.
# HOOKS_SKIP="NAME..." skips those hooks for one command, as in
# HOOKS_SKIP=test-push git push.
#
# Then the hooks in PRIVATE/EVENT.d run the same way, PRIVATE being git
# config hooks.privateDir, default ~/.config/git/hooks.private: hooks a
# machine keeps out of the repositories, for the events dispatch is
# installed for.
set -uo pipefail

export GIT_HOOK_EVENT=${0##*/}
dir=$0.d
private=$(git config --path hooks.privateDir || echo "$HOME/.config/git/hooks.private")
private=$private/$GIT_HOOK_EVENT.d
[[ -d $dir || -d $private ]] || exit 0

# pre-push and post-rewrite read git's list on stdin; each hook gets it all.
input=/dev/null
case $GIT_HOOK_EVENT in
    pre-push | post-rewrite)
        input=$(mktemp)
        trap 'command rm -f "$input"' EXIT
        cat >"$input"
        ;;
esac

mapfile -d '' hooks < <(LC_ALL=C; printf '%s\0' "$dir"/* "$private"/*)
for hook in "${hooks[@]}"; do
    name=${hook##*/}
    [[ -x $hook && $name != *.off && " ${HOOKS_SKIP-} " != *" $name "* ]] || continue
    "$hook" "$@" <"$input"
    status=$?
    if ((status)) && [[ $GIT_HOOK_EVENT != post-* ]]; then
        exit "$status"
    fi
done
exit 0
