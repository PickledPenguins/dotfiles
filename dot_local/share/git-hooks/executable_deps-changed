#!/usr/bin/env bash
# deps-changed -- say when a checkout, merge or rebase changed a dependency file.
# events: post-checkout post-merge post-rewrite
# config: hooks.depsFiles
#
# Prints which dependency files differ, so the environment can be updated
# (pip install -e ., npm install, ...).  hooks.depsFiles is the list of file
# names, separated by spaces, matched in any directory; the default covers
# Python, JavaScript, Rust, Go and Ruby: requirements*.txt pyproject.toml
# setup.py setup.cfg Pipfile.lock poetry.lock uv.lock environment.yml
# package.json package-lock.json yarn.lock pnpm-lock.yaml Cargo.lock go.sum
# Gemfile.lock.  A file checkout, an amend and the steps inside a rebase are
# not checked; the rebase as a whole is.
set -euo pipefail

case $GIT_HOOK_EVENT in
    post-checkout)
        [[ $3 == 1 && $1 != "$2" ]] || exit 0
        [[ -d $(git rev-parse --git-path rebase-merge) || -d $(git rev-parse --git-path rebase-apply) ]] && exit 0
        old=$1 new=$2
        ;;
    post-merge) old=ORIG_HEAD new=HEAD ;;
    post-rewrite)
        [[ $1 == rebase ]] || exit 0
        old=ORIG_HEAD new=HEAD
        ;;
    *) exit 0 ;;
esac
read -ra names <<<"$(git config hooks.depsFiles || echo 'requirements*.txt pyproject.toml setup.py setup.cfg Pipfile.lock poetry.lock uv.lock environment.yml package.json package-lock.json yarn.lock pnpm-lock.yaml Cargo.lock go.sum Gemfile.lock')"
pathspecs=("${names[@]/#/:(glob)**/}")
mapfile -t changed < <(git diff --name-only "$old" "$new" -- "${pathspecs[@]}" 2>/dev/null || true)
((${#changed[@]})) || exit 0
printf 'deps-changed: %s changed; update the environment\n' "${changed[@]}" >&2
