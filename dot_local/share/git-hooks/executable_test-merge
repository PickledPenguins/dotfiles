#!/usr/bin/env bash
# test-merge: run the tests on a merge before git records it.
# events: pre-merge-commit
# config: hooks.test
# requires: hooks.test
#
# hooks.test is the command, run by sh at the top of the work tree, which
# holds the merged result at that point:
#     git config hooks.test "./run-tests.sh fast"
# A failure stops the merge with the result staged; fix it and commit, or
# skip the hook with git merge --no-verify. git runs this only for a merge
# it commits itself: a fast-forward, a merge stopped by a conflict, and
# git merge --no-commit do not run it.
set -euo pipefail

cmd=$(git config hooks.test) || { echo "test-merge: set git config hooks.test CMD" >&2; exit 1; }
sh -c "$cmd" </dev/null && exit 0
echo "test-merge: tests fail; git merge --abort undoes the merge" >&2
exit 1
