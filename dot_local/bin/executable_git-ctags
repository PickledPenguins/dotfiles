#!/usr/bin/env bash
# git-ctags -- a tags file for a git repository, rebuilt by a git hook.
#
#   git ctags         build tags at the worktree's root now, then install
#                     and switch on the packaged ctags hook (git hooks)
#   git ctags off     remove the hook, delete this worktree's tags
#   git ctags --hook  what the hook runs: rebuild now
#
# The hook rebuilds after post-checkout (switch, checkout, worktree add,
# clone), post-merge (pull, merge), post-rewrite (rebase, amend) and
# post-commit, in the background; git never waits for it or fails because
# of it.  The hooks directory is shared by every worktree, so a new
# worktree gets its tags on its first checkout.  The file is written beside
# the real one and renamed, so an editor never reads half of it; a rebuild
# that finds HEAD moved meanwhile is dropped, as the next hook's run is
# newer.
#
# Options for ctags itself are in ~/.ctags.d/default.ctags.
# Needs: universal-ctags, and git-hooks for the hook.
set -euo pipefail

tmp=''
trap 'command rm -f "$tmp"' EXIT

build() {
    local top head
    top=$(git rev-parse --show-toplevel)
    head=$(git rev-parse -q --verify HEAD || true)
    tmp=$(mktemp "$top/.tags.XXXXXX")
    (cd "$top" && ctags --exclude=tags --exclude='.tags.*' -f "$tmp")
    if [[ $(git rev-parse -q --verify HEAD || true) == "$head" ]]; then
        chmod 644 "$tmp"
        command mv "$tmp" "$top/tags"
    fi
}

case ${1-} in
    '')
        ctags --version 2>/dev/null | grep -q '^Universal Ctags' || {
            echo "git ctags: needs universal-ctags on PATH" >&2
            exit 1
        }
        build
        git hooks install ctags >/dev/null
        git hooks on ctags >/dev/null
        echo "git ctags: $(git rev-parse --show-toplevel)/tags, rebuilt by the ctags hook"
        ;;
    off)
        git hooks remove ctags >/dev/null
        command rm -f "$(git rev-parse --show-toplevel)/tags"
        ;;
    --hook)
        command -v ctags >/dev/null || exit 0
        build
        ;;
    *)
        echo "usage: git ctags [off]" >&2
        exit 2
        ;;
esac
