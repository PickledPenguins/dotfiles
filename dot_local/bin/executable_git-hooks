#!/usr/bin/env bash
# git-hooks: install the packaged git hooks in a repository, switch them on and off.
#
#   git hooks                   this repository's hooks: state, event, name, file
#   git hooks available         the packaged hooks: state here, name, summary
#   git hooks show NAME         what a packaged hook does, its settings, its state here
#   git hooks install [NAME...] install packaged hooks, switched off (default: all)
#   git hooks remove [NAME...]  remove installed packaged hooks (default: all)
#   git hooks on NAME...        switch hooks on
#   git hooks off [NAME...]     switch hooks off (default: every hook that is on)
#   git hooks update            bring the installed hooks and the template in line with the packaged ones
#   git hooks template          write the template init.templateDir names: every hook, off
#
# The packaged hooks live in ~/.local/share/git-hooks, each describing itself
# in its header. git runs one file per event, so install links
# .git/hooks/EVENT to the dispatcher there, which runs each
# .git/hooks/EVENT.d/NAME in name order, byte order (C) whatever the
# locale, as every listing here is. A hook is off while its name ends
# in .off. A hook the repository already had for the event moves into
# EVENT.d under the event's name, in the state it was in, and remove moves it
# back once no packaged hook is left there. A hook that needs a setting
# (its "requires:" line, git config hooks.KEY) is not switched on until the
# setting is made. on and off also switch a plain hook at the top of the
# hooks directory, by its event name. The hooks directory is shared by
# every worktree of the repository.
#
# After dots apply brings new or changed packaged hooks, update removes each
# installed hook missing from the catalog, and each link on an event its
# header does not list. It installs an event a hook gained in the state the
# hook is in, as install does. template keeps
# ~/.local/share/git-template/hooks as install leaves a repository, every
# packaged hook off, its links going through ~/.local/share/git-hooks as
# install's do. A repository git init makes from it keeps working after the
# checkout moves, once dots apply runs. update rewrites the template too
# when it exists, and says so when that changed it. Every other command
# warns, in one line, while the template's hooks or events differ from the
# packaged ones.
#
# git has no event after a push completes, so there is no post-push hook.
set -euo pipefail
shopt -s nullglob
# Names sort, and globs expand, in byte order, as dispatch runs them
export LC_ALL=C

catalog=$HOME/.local/share/git-hooks
dispatch=$catalog/dispatch
template=$HOME/.local/share/git-template
dir=''

in_repo() { git rev-parse --git-dir >/dev/null 2>&1; }

hooks_dir() {
    [[ -n $dir ]] || dir=$(git rev-parse --path-format=absolute --git-path hooks)
}

exists() { [[ -e $1 || -L $1 ]]; }

is_dispatch() { [[ -L $1 && $(realpath -m -- "$1") == "$(realpath -m -- "$dispatch")" ]]; }

# ours PATH NAME: PATH is install's link to the packaged hook NAME, even one
# since dropped from the catalog.
ours() { [[ -L $1 && $(realpath -m -- "$1") == "$(realpath -m -- "$catalog/$2")" ]]; }

# Each packaged hook installed here, by name, once each
installed() {
    local path name
    for path in "$dir"/*.d/*; do
        name=${path##*/}
        name=${name%.off}
        if ours "$path" "$name"; then echo "$name"; fi
    done | sort -u
}

# Each packaged hook's name: the catalog files with an "events:" line.
packaged() {
    local path
    for path in "$catalog"/*; do
        grep -q '^# events: ' "$path" && echo "${path##*/}"
    done
    return 0
}

# field NAME KEY: the value of the "# KEY: " line in NAME's header.
field() {
    awk -v key="# $2: " 'NR > 1 && !/^#/ {exit} index($0, key) == 1 {print substr($0, length(key) + 1); exit}' "$catalog/$1"
}

check_packaged() {
    local name
    for name; do
        [[ -f $catalog/$name ]] && grep -q '^# events: ' "$catalog/$name" && continue
        echo "git hooks: no packaged hook $name (git hooks available)" >&2
        exit 1
    done
}

# state NAME: on, off, or - when NAME is in no EVENT.d here.
state() {
    local path found=-
    for path in "$dir"/*.d/"$1" "$dir"/*.d/"$1".off; do
        [[ $path == *.off ]] || { echo on; return; }
        found=off
    done
    echo "$found"
}

# ensure_dispatch EVENT: link .git/hooks/EVENT to the dispatcher, moving the
# hook that was there into EVENT.d.
ensure_dispatch() {
    local hook=$dir/$1 old new target
    is_dispatch "$hook" && return
    if exists "$hook" && exists "$hook.off"; then
        echo "git hooks: both $1 and $1.off exist in $dir; remove one" >&2
        exit 1
    fi
    command mkdir -p "$hook.d"
    for old in "$hook" "$hook.off"; do
        exists "$old" || continue
        new=$hook.d/${old##*/}
        target=$(readlink -- "$old" || true)
        if [[ -n $target && $target != /* ]]; then
            ln -s "../$target" "$new"
            command rm -f -- "$old"
        else
            command mv -- "$old" "$new"
        fi
        echo "$1: the hook that was there moved to $1.d/${old##*/}"
    done
    ln -s "$dispatch" "$hook"
}

# tidy EVENT: once EVENT.d holds nothing but the event's own old hook, put
# that back and drop the dispatcher.
tidy() {
    local hook=$dir/$1 path target
    is_dispatch "$hook" || return 0
    for path in "$hook.d"/*; do
        [[ ${path##*/} == "$1" || ${path##*/} == "$1.off" ]] || return 0
    done
    command rm -f -- "$hook"
    for path in "$hook.d"/*; do
        target=$(readlink -- "$path" || true)
        if [[ $target == ../* ]]; then
            ln -s "${target#../}" "$dir/${path##*/}"
            command rm -f -- "$path"
        else
            command mv -- "$path" "$dir/${path##*/}"
        fi
    done
    rmdir -- "$hook.d"
}

# install NAME...: link each hook on each of its events, off. An event added
# to a hook already installed takes the state the hook is in. quiet=1 leaves
# out the hooks already installed.
install() {
    local name event added link was
    for name; do
        added=''
        was=$(state "$name")
        for event in $(field "$name" events); do
            link=$dir/$event.d/$name
            exists "$link" || exists "$link.off" && continue
            ensure_dispatch "$event"
            if [[ $was == on ]]; then ln -s "$catalog/$name" "$link"; else ln -s "$catalog/$name" "$link.off"; fi
            [[ $was == - ]] || echo "$name added to $event, $was"
            added=1
        done
        if [[ $was == - ]]; then
            echo "$name installed, off"
        elif [[ -z $added && -z ${quiet-} ]]; then
            echo "$name is already installed"
        fi
    done
}

remove() {
    local name path removed event
    for name; do
        removed=''
        for path in "$dir"/*.d/"$name" "$dir"/*.d/"$name".off; do
            [[ -L $path && $(realpath -m -- "$path") == "$(realpath -m -- "$catalog/$name")" ]] || continue
            command rm -f -- "$path"
            removed=1
        done
        if [[ -n $removed ]]; then echo "$name removed"; else echo "$name is not installed"; fi
    done
    for path in "$dir"/*.d; do
        event=${path##*/}
        tidy "${event%.d}"
    done
}

# update: remove each installed hook missing from the catalog, and each link
# on an event its header does not list. Install the events a hook gained.
update() {
    local path name event
    for path in "$catalog"/*; do
        [[ -e $path ]] && continue
        echo "git hooks: $path is a broken link; run dots apply first" >&2
        exit 1
    done
    for path in "$dir"/*.d/*; do
        name=${path##*/}
        name=${name%.off}
        ours "$path" "$name" || continue
        event=${path%.d/*}
        event=${event##*/}
        if [[ ! -f $catalog/$name ]] || ! grep -q '^# events: ' "$catalog/$name"; then
            command rm -f -- "$path"
            echo "$name removed from $event: no longer packaged"
        elif [[ " $(field "$name" events) " != *" $event "* ]]; then
            command rm -f -- "$path"
            echo "$name removed from $event: no longer one of its events"
        fi
    done
    quiet=1 install $(installed)
    for path in "$dir"/*.d; do
        event=${path##*/}
        tidy "${event%.d}"
    done
}

# write_template: the template as install leaves a repository, every
# packaged hook off, a hook dropped from the catalog left out and a missing
# dispatcher put back.
write_template() {
    local path event hooks
    dir=$template/hooks
    command mkdir -p "$dir"
    update
    mapfile -t hooks < <(packaged)
    quiet=1 install "${hooks[@]}"
    for path in "$dir"/*.d; do
        event=${path##*/}
        ensure_dispatch "${event%.d}"
    done
}

# template_behind: true when the template exists and a packaged hook is
# missing from one of its events there, an event lacks the dispatcher, or
# the template holds a hook on an event the catalog does not give it. One
# awk over the catalog, no other process.
template_behind() {
    local hooks=$template/hooks path entry n=0
    local -A want=()
    [[ -d $hooks ]] || return 1
    while read -r entry; do
        want[$entry]=1
    done < <(awk '/^# events: / {name = FILENAME; sub(/.*\//, "", name); for (i = 3; i <= NF; i++) print $i "/" name; nextfile}' \
        "$catalog"/* 2>/dev/null)
    for path in "$hooks"/*.d/*; do
        entry=${path%.d/*}
        entry=${entry##*/}/${path##*/}
        [[ -n ${want[${entry%.off}]-} ]] || return 0
        n=$((n + 1))
    done
    ((n == ${#want[@]})) || return 0
    for entry in "${!want[@]}"; do
        [[ $hooks/${entry%/*} -ef $dispatch ]] || return 0
    done
    return 1
}

# switch on|off NAME: rename every NAME.off to NAME, or NAME to NAME.off, in
# the EVENT.d directories and at the top of the hooks directory.
switch() {
    local name=${2%.off} path base from to found='' changed=''
    for path in "$dir"/*.d/"$name" "$dir"/*.d/"$name".off "$dir/$name" "$dir/$name.off"; do
        exists "$path" && ! is_dispatch "$path" || continue
        base=${path%.off}
        if exists "$base" && exists "$base.off"; then
            echo "git hooks: both $base and $base.off exist; remove one" >&2
            exit 1
        fi
        found=1
        if [[ $1 == on ]]; then from=$base.off to=$base; else from=$base to=$base.off; fi
        [[ $path == "$from" ]] || continue
        command mv -- "$from" "$to"
        changed=1
    done
    if [[ -z $found ]]; then
        echo "git hooks: no hook $name in $dir (git hooks install $name)" >&2
        exit 1
    fi
    if [[ -n $changed ]]; then echo "$name $1"; else echo "$name is already $1"; fi
}

# Every hook that is on, by name, once each; never a dispatcher.
on_now() {
    local path name
    for path in "$dir"/*.d/* "$dir"/*; do
        name=${path##*/}
        [[ ! -d $path && $name != *.off && $name != *.sample ]] && ! is_dispatch "$path" && echo "$name"
    done | sort -u
}

case ${1-} in
    update | template | -h) ;;
    *)
        if template_behind; then
            echo "git hooks: $template is behind the packaged hooks; run git hooks template" >&2
        fi
        ;;
esac

case ${1-} in
    '')
        hooks_dir
        for path in "$dir"/*; do
            name=${path##*/}
            [[ ! -d $path && $name != *.sample ]] || continue
            if is_dispatch "$path"; then
                for entry in "$path.d"/*; do
                    entry_name=${entry##*/}
                    state=on
                    [[ $entry_name == *.off ]] && state=off
                    printf '%-3s %-18s %-20s %s\n' "$state" "${name%.off}" "${entry_name%.off}" "$(realpath -m -- "$entry")"
                done
            else
                state=on
                [[ $name == *.off ]] && state=off
                printf '%-3s %-18s %-20s %s\n' "$state" "${name%.off}" "${name%.off}" "$(realpath -m -- "$path")"
            fi
        done
        ;;
    available)
        in_repo && hooks_dir
        for name in $(packaged); do
            here=-
            [[ -n $dir ]] && here=$(state "$name")
            printf '%-3s %-20s %s\n' "$here" "$name" "$(sed -n '2s/^# [^ ]*: //p' "$catalog/$name")"
        done
        ;;
    show)
        (($# == 2)) || { echo "usage: git hooks show NAME" >&2; exit 2; }
        check_packaged "$2"
        awk 'NR == 1 {next} !/^#/ {exit} {sub(/^# ?/, ""); print}' "$catalog/$2"
        echo
        for key in $(field "$2" config); do
            printf '%s = %s\n' "$key" "$(git config --get "$key" || echo '(unset)')"
        done
        if in_repo; then
            hooks_dir
            here=$(state "$2")
            printf 'here: %s\n' "${here/#-/not installed}"
        else
            echo "here: not in a git repository"
        fi
        ;;
    install)
        shift
        hooks_dir
        (($#)) || set -- $(packaged)
        check_packaged "$@"
        install "$@"
        ;;
    remove)
        shift
        hooks_dir
        (($#)) || set -- $(installed)
        here=" $(installed | tr '\n' ' ')"
        for name; do
            [[ $here == *" $name "* ]] || check_packaged "$name"
        done
        remove "$@"
        ;;
    update)
        (($# == 1)) || { echo "usage: git hooks update" >&2; exit 2; }
        if in_repo || [[ ! -d $template/hooks ]]; then
            hooks_dir
            update
        fi
        if [[ -d $template/hooks ]]; then
            changes=$(write_template)
            [[ -z $changes ]] || echo "template updated: $template"
        fi
        ;;
    template)
        (($# == 1)) || { echo "usage: git hooks template" >&2; exit 2; }
        write_template
        ;;
    on)
        (($# > 1)) || { echo "usage: git hooks on NAME... (git hooks available lists them)" >&2; exit 2; }
        shift
        hooks_dir
        for name; do
            [[ -f $catalog/$name ]] || continue
            for key in $(field "$name" requires); do
                git config --get "$key" >/dev/null || {
                    echo "git hooks: $name needs git config $key; set it first (git hooks show $name)" >&2
                    exit 1
                }
            done
        done
        for name; do
            switch on "$name"
        done
        ;;
    off)
        shift
        hooks_dir
        (($#)) || set -- $(on_now)
        for name; do
            switch off "$name"
        done
        ;;
    -h)
        sed -n '2,/^set /{/^set /d; s/^# \{0,1\}//; p}' "$0"
        ;;
    *)
        echo "usage: git hooks [available | show NAME | install [NAME...] | remove [NAME...] | on NAME... | off [NAME...] | update | template | -h]" >&2
        exit 2
        ;;
esac
