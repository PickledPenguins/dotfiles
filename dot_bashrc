# ~/.bashrc: loader only. Everything lives in ~/.config/bash/rc.d/.
#
# Each NN-name.sh there has one concern and lists its settings, every one
# described in the comment above it. A setting with "#" directly in front
# of it is off: delete that "#" to turn it on, or add one to turn a setting
# off. `dots options WORD` searches every file. Ways to change things,
# most to least permanent:
#
#   1. edit the module (committed, every machine)
#   2. turn a whole module off:
#        every machine:  git mv rc.d/70-conda.sh rc.d/70-conda.sh.off
#        this machine:   echo conda >> ~/.config/bash/disabled
#   3. this machine only, never committed:
#        ~/.bashrc.before   read FIRST -- DOTFILES_* knobs (each module's header lists its own)
#        ~/.bashrc.local    read LAST  -- any setting line, overrides, extra aliases, secrets
#
# DOTFILES_DEBUG=1 bash -i   prints each module as it loads, with its time
#                            (bash 5+; bash 4 shows 0 ms).

# Only interactive shells read the rest: scripts, scp and cron stay fast and
# unaffected.
case $- in *i*) ;; *) return ;; esac

# Where the modules are, and the repository (for dots and the modules).
DOTFILES_BASH_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bash"
DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export DOTFILES_DIR

# This machine's knobs, before any module reads them.
[[ -r ~/.bashrc.before ]] && source ~/.bashrc.before

# A module is skipped on this machine when its name (without number and
# .sh) is a line of ~/.config/bash/disabled; # starts a comment there.
# Read once, with builtins: no process per module on a slow disk.
declare -A _dotfiles_off=()
if [[ -r "$DOTFILES_BASH_DIR/disabled" ]]; then
    while IFS= read -r _name || [[ -n $_name ]]; do
        _name="${_name%%#*}"; _name="${_name//[[:space:]]/}"
        [[ -n $_name ]] && _dotfiles_off[$_name]=1
    done < "$DOTFILES_BASH_DIR/disabled"
fi

# Every rc.d/*.sh in number order; .sh.off files are not matched. With
# DOTFILES_DEBUG set, each one's name and load time goes to stderr. A
# second load (reload) is startup again: no clash warnings until the end.
unset _dotfiles_started
for _rc in "$DOTFILES_BASH_DIR"/rc.d/*.sh; do
    [[ -r "$_rc" ]] || continue
    _name="${_rc##*/}"; _name="${_name%.sh}"; _name="${_name#[0-9][0-9]-}"
    if [[ -n ${_dotfiles_off[$_name]-} ]]; then
        [[ -n "${DOTFILES_DEBUG-}" ]] && echo "bashrc: skip $_name" >&2
        continue
    fi
    _t0=${EPOCHREALTIME/./}                 # microseconds, bash 5+
    source "$_rc"
    [[ -n "${DOTFILES_DEBUG-}" ]] && printf 'bashrc: %-14s %5d ms\n' "$_name" "$(( (${EPOCHREALTIME/./} - _t0) / 1000 ))" >&2
done
unset _rc _name _t0 _dotfiles_off

# Startup is over: from here path_prepend and path_append warn about name
# clashes (20-path.sh).
_dotfiles_started=1
